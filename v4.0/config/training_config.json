{
  "project": {
    "name": "v7p3r-chess-ai",
    "version": "4.0.0",
    "stage": "stage1",
    "description": "Multi-Agent Chess AI Enhancement Layer"
  },
  
  "hardware": {
    "gpu_enabled": true,
    "gpu_id": 0,
    "gpu_name": "RTX 4070 Ti",
    "cpu_threads": 8,
    "ram_limit_gb": 16
  },
  
  "stage1": {
    "name": "Pattern Recognition & Move Ordering",
    "enabled": true,
    
    "data": {
      "puzzle_database_path": "data/puzzles/4M_puzzle_library/",
      "puzzle_count": 4000000,
      "train_split": 0.8,
      "val_split": 0.1,
      "test_split": 0.1,
      "augmentation_enabled": true
    },
    
    "model": {
      "architecture": "GRU",
      "num_layers": 12,
      "hidden_size": 512,
      "dropout": 0.3,
      "input_features": 690,
      "num_themes": 50
    },
    
    "training": {
      "batch_size": 64,
      "learning_rate": 0.001,
      "weight_decay": 0.0001,
      "epochs": 100,
      "early_stopping_patience": 10,
      "gradient_clip": 1.0,
      "scheduler": "ReduceLROnPlateau",
      "scheduler_patience": 5,
      "scheduler_factor": 0.5
    },
    
    "validation": {
      "theme_accuracy_target": 0.90,
      "top5_accuracy_target": 0.85,
      "top10_accuracy_target": 0.95,
      "inference_speed_ms": 5
    },
    
    "checkpointing": {
      "save_interval": 5,
      "keep_top_k": 3,
      "checkpoint_dir": "models/stage1_themes/"
    }
  },
  
  "stage2": {
    "name": "Historical Analysis & Correction",
    "enabled": false,
    
    "data": {
      "historical_games_path": "data/historical_games/v7p3r_pgns/",
      "stockfish_depth": 20,
      "stockfish_multipv": 5,
      "min_position_frequency": 2,
      "correction_weight": 10.0
    },
    
    "model": {
      "architecture": "GRU",
      "num_layers": 10,
      "hidden_size": 384,
      "dropout": 0.3
    },
    
    "training": {
      "batch_size": 32,
      "learning_rate": 0.0005,
      "epochs": 50
    },
    
    "validation": {
      "correction_rate_target": 0.90,
      "false_positive_target": 0.05,
      "lookup_speed_ms": 1
    }
  },
  
  "stage3": {
    "name": "Opening & Endgame Specialization",
    "enabled": false,
    
    "opening": {
      "opening_book_path": "data/opening_book/master_games_db/",
      "book_depth": 15,
      "novelty_detection_enabled": true
    },
    
    "endgame": {
      "tablebase_path": "data/tablebases/syzygy_6piece/",
      "max_pieces": 6,
      "mate_search_depth": 5,
      "mate_timeout_ms": 500
    }
  },
  
  "stage4": {
    "name": "Middlegame Augmentation",
    "enabled": false,
    
    "self_play": {
      "num_games": 10000,
      "parallel_workers": 8,
      "time_controls": ["bullet", "blitz", "rapid"],
      "stockfish_opponent_percentage": 0.05
    },
    
    "model": {
      "architecture": "ResNet",
      "num_blocks": 20,
      "filters": 256,
      "policy_head_enabled": true,
      "value_head_enabled": true
    },
    
    "training": {
      "iterations": 1000,
      "games_per_iteration": 100,
      "batch_size": 256,
      "learning_rate": 0.0001,
      "replay_buffer_size": 100000
    }
  },
  
  "logging": {
    "log_level": "INFO",
    "tensorboard_enabled": true,
    "wandb_enabled": false,
    "wandb_project": "v7p3r-chess-ai-v4",
    "log_dir": "logs/",
    "save_training_plots": true
  },
  
  "performance": {
    "jit_compile": false,
    "mixed_precision": false,
    "compile_model": false,
    "num_workers": 4,
    "pin_memory": true
  }
}
