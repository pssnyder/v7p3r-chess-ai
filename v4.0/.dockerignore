# Docker build optimization - exclude unnecessary files

# Git
.git
.gitignore
.github

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
build
.eggs
pip-log.txt
pip-delete-this-directory.txt
.tox
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis
.pytest_cache

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints
*.ipynb

# Logs (will be mounted as volume)
logs/
*.log

# Model checkpoints (will be mounted as volume)
models/*/
*.pt
*.pth
*.onnx

# Data files (will be mounted as volume)
data/*/
*.json
*.csv
*.pgn
*.db

# TensorBoard (will be mounted as volume)
tensorboard_logs/
runs/

# Temporary files
tmp/
temp/
*.tmp

# Documentation (not needed in container)
docs/
*.md
!DOCKER_TRAINING_GUIDE.md

# Test files
test_*.py
tests/

# Windows
Thumbs.db
desktop.ini

# Large binaries (Stockfish installed via apt)
*.exe

# Backup files
*.backup
*.bak
*_backup/
