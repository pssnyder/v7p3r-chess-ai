graph TB
    %% ============================================
    %% V7P3R AI v5.0 Training Pipeline DFD
    %% Supervised Learning with Heuristic Features
    %% ============================================
    
    %% -------------------- DATA SOURCES --------------------
    subgraph Sources["📥 DATA SOURCES"]
        PGN[("Historical PGNs<br/>(v18.3 Games)")]
        PUZZLE[("Puzzle Database<br/>(Lichess Puzzles)")]
        SELFPLAY[("Self-Play Games<br/>(AI vs AI)")]
    end
    
    %% -------------------- EXTRACTION --------------------
    subgraph Extract["🔍 POSITION EXTRACTION"]
        PGN_PARSE["PGN Parser<br/>Replay Games"]
        PUZZLE_RUN["Puzzle Solver<br/>v18.3 UCI"]
        SELFPLAY_RUN["Self-Play Engine<br/>v7p3r AI UCI"]
        
        PGN_PARSE --> |"Position FEN<br/>Move SAN/UCI<br/>Game Metadata"| RAW_PGN[(Raw PGN Records)]
        PUZZLE_RUN --> |"Position FEN<br/>Move Selected<br/>Theme/Difficulty"| RAW_PUZZLE[(Raw Puzzle Records)]
        SELFPLAY_RUN --> |"Position FEN<br/>Move Played<br/>Game Context"| RAW_SELFPLAY[(Raw Self-Play Records)]
    end
    
    PGN --> PGN_PARSE
    PUZZLE --> PUZZLE_RUN
    SELFPLAY --> SELFPLAY_RUN
    
    %% -------------------- HEURISTIC FEATURE EXTRACTION --------------------
    subgraph Heuristics["🎯 HEURISTIC FEATURE EXTRACTION"]
        CALC["V7P3R Heuristic Calculator<br/>(Binary Observations)"]
        
        CALC --> |"Material Flags<br/>PST Observations<br/>Tactical Flags<br/>Positional Flags"| FEATURES
        
        FEATURES["<b>Feature Set (Binary/Categorical)</b><br/>━━━━━━━━━━━━━━━━━━━━<br/>✓ Has material advantage<br/>✓ Rooks on open file<br/>✓ King in center<br/>✓ Passed pawns present<br/>✓ Bishop pair active<br/>✓ Doubled pawns exist<br/>✓ Enemy king exposed<br/>✓ Pieces developed<br/>✓ Castling completed<br/>✓ Tactical motifs present<br/>━━━━━━━━━━━━━━━━━━━━<br/><i>NOT weighted scores,<br/>just observations</i>"]
    end
    
    RAW_PGN --> CALC
    RAW_PUZZLE --> CALC
    RAW_SELFPLAY --> CALC
    
    %% -------------------- STOCKFISH ANALYSIS --------------------
    subgraph StockfishAnalysis["⚡ STOCKFISH ANALYSIS"]
        SF["Stockfish Engine<br/>Depth 20, MultiPV 5"]
        GRADE["Move Quality Grader"]
        
        SF --> |"Top 5 Moves<br/>Evaluations<br/>Best Move"| GRADE
        GRADE --> |"Grade: 0-5<br/>Rank in Top-5<br/>Eval Loss"| GRADING
        
        GRADING["<b>Quality Grading</b><br/>━━━━━━━━━━━━━━<br/>5 = Excellent (Top-1)<br/>4 = Good (Top-2/3)<br/>3 = OK (Top-4/5)<br/>2 = Inaccuracy<br/>1 = Mistake<br/>0 = Blunder"]
    end
    
    FEATURES --> SF
    
    %% -------------------- KNOWLEDGE BASE --------------------
    subgraph KnowledgeBase["📚 KNOWLEDGE BASE (Training Dataset)"]
        KB[("Unified Training Dataset<br/>━━━━━━━━━━━━━━━━━━━━<br/>Position FEN<br/>Move Played<br/>Heuristic Features (Binary)<br/>Stockfish Grade (0-5)<br/>Source (PGN/Puzzle/Self-Play)<br/>Metadata<br/>━━━━━━━━━━━━━━━━━━━━<br/>Target: Millions of Records")]
    end
    
    GRADING --> KB
    
    %% -------------------- TRAINING --------------------
    subgraph Training["🧠 MODEL TRAINING (Supervised Learning)"]
        MODEL["Neural Network<br/>━━━━━━━━━━━━━━<br/>Input: Position + Heuristic Features<br/>Output: Move Quality Prediction"]
        
        LOSS["Loss Function<br/>━━━━━━━━━━━━━━<br/>Predict Grade (0-5)<br/>vs Stockfish Grade<br/>+ V7P3R Style Bonus"]
        
        OPTIMIZE["Optimizer<br/>━━━━━━━━━━━━━━<br/>Adjust Weights<br/>Learn Feature Relevance"]
        
        KB --> |"Training Batch<br/>(Position, Features, Grade)"| MODEL
        MODEL --> |"Predicted Grade"| LOSS
        LOSS --> |"Gradient"| OPTIMIZE
        OPTIMIZE --> |"Updated Weights"| MODEL
    end
    
    %% -------------------- DEPLOYMENT --------------------
    subgraph Deploy["🚀 DEPLOYMENT"]
        UCI["V7P3R AI v5.0<br/>UCI Engine Wrapper"]
        
        INFER["Inference Engine<br/>━━━━━━━━━━━━━━<br/>1. Extract Heuristic Features<br/>2. Run Neural Network<br/>3. Predict Move Quality<br/>4. Select Best Move"]
        
        UCI --> INFER
    end
    
    MODEL -.->|"Trained Model"| INFER
    
    %% -------------------- FEEDBACK LOOP --------------------
    subgraph Feedback["🔄 CONTINUOUS LEARNING LOOP"]
        ARENA["Arena Tournaments<br/>V7P3R AI vs Opponents"]
        PUZZLE_TEST["Puzzle Testing<br/>V7P3R AI Solver"]
        SELF_TRAIN["Self-Play Training<br/>AI vs AI"]
        
        ARENA --> |"New Game PGNs"| PGN
        PUZZLE_TEST --> |"New Puzzle Attempts"| PUZZLE
        SELF_TRAIN --> |"New Self-Play Games"| SELFPLAY
    end
    
    INFER --> ARENA
    INFER --> PUZZLE_TEST
    INFER --> SELF_TRAIN
    
    %% -------------------- KEY INSIGHTS --------------------
    subgraph Insights["💡 KEY DESIGN PRINCIPLES"]
        P1["<b>1. Heuristics as Observations</b><br/>V7P3R eval functions calculate<br/>FEATURES, not scores.<br/>AI learns feature weights."]
        
        P2["<b>2. Stockfish as Teacher</b><br/>Grades (0-5) provide<br/>corrective feedback.<br/>Supervised learning target."]
        
        P3["<b>3. Pattern Learning</b><br/>AI finds patterns in<br/>graded positions.<br/>Self-corrects logic."]
        
        P4["<b>4. Continuous Improvement</b><br/>New games → new data<br/>→ retrain model<br/>→ better decisions."]
    end
    
    %% -------------------- STYLING --------------------

    
    class PGN,PUZZLE,SELFPLAY sourceStyle
    class PGN_PARSE,PUZZLE_RUN,SELFPLAY_RUN,CALC,SF,GRADE processStyle
    class RAW_PGN,RAW_PUZZLE,RAW_SELFPLAY,FEATURES,GRADING,KB dataStyle
    class MODEL,LOSS,OPTIMIZE trainStyle
    class UCI,INFER,ARENA,PUZZLE_TEST,SELF_TRAIN deployStyle
    class P1,P2,P3,P4 insightStyle
